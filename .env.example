# Copy to .env for local dev, and set the same names/values in
# Netlify → Site configuration → Environment variables for the deployed build.
#
# WARNING: this is a static client-only app. Vite bakes every VITE_ var
# directly into the shipped JS bundle — these are NOT server-side secrets.
# Anyone visiting the deployed site can read them via dev tools. See README.

VITE_OPENAI_API_KEY=
VITE_ANTHROPIC_API_KEY=
VITE_GEMINI_API_KEY=
VITE_TAVILY_API_KEY=
